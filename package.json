{
  "name": "exec-wiki-bgm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/web-tree-sitter/web-tree-sitter.wasm', 'static/web-tree-sitter.wasm')\"",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "deploy": "npm run build && wrangler deploy",
    "gen": "wrangler types",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.2",
    "@unocss/extractor-svelte": "^66.7.5",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tslib": "^2.8.1",
    "typescript": "^6",
    "unocss": "^66.7.5",
    "vite": "^8.2.0",
    "vite-plugin-devtools-json": "^1.1.0",
    "wrangler": "^4.97.0"
  },
  "type": "module",
  "dependencies": {
    "@bgm38/wiki": "^0.3.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@nozbe/microfuzz": "^1.0.0",
    "deno-cli": "^1.0.5",
    "dexie": "^4.4.4",
    "fast-array-diff": "^1.1.0",
    "web-tree-sitter": "^0.26.11"
  }
}
